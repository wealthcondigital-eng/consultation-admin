# Which data sources the console is built from — mirrors `AppBackend` in the
# Flutter app. `fake` walks every screen with no API running; `live` talks to
# the consultation API in ../server.
NEXT_PUBLIC_BACKEND=fake

# The consultation API. Server-side only: the browser never calls the API
# directly, it calls this app's own /api routes, which forward the request with
# the admin session attached. See src/core/network/api-client.ts.
API_BASE_URL=http://localhost:4000

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-me-with-32-random-bytes
